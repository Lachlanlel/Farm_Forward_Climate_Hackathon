{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowJs": true
  },
  "include": [
    "src/frontend/scene/**/*.ts",
    "src/backend/results/**/*.js",
    "src/shared/results-contract.js",
    "src/shared/results-types.d.ts"
  ]
}
